<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivDetail"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:contentDescription="@string/item_image"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_placeholder"
            app:tint="@color/umbb_blue" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAlignment="viewStart"
            android:textColor="@color/umbb_blue"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Faculty of Sciences" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/description"
            android:textAlignment="viewStart"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:textAlignment="viewStart"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            tools:text="Detailed description of the faculty or department." />

        <TextView
            android:id="@+id/tvSpecialtiesLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/specialties"
            android:textAlignment="viewStart"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSpecialties"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:textAlignment="viewStart"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            tools:text="Computer Science\nMathematics\nPhysics" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/contact"
            android:textAlignment="viewStart"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCall"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/call"
                android:textSize="12sp"
                app:icon="@drawable/ic_call"
                app:iconGravity="top"
                app:iconPadding="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSms"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/sms"
                android:textSize="12sp"
                app:icon="@drawable/ic_sms"
                app:iconGravity="top"
                app:iconPadding="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmail"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/email"
                android:textSize="12sp"
                app:icon="@drawable/ic_email"
                app:iconGravity="top"
                app:iconPadding="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMap"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/map"
                android:textSize="12sp"
                app:icon="@drawable/ic_location"
                app:iconGravity="top"
                app:iconPadding="4dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
